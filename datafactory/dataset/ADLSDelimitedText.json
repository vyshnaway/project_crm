{
	"name": "ADLSDelimitedText",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"filename": {
				"type": "string",
				"defaultValue": "_files_.csv"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().filename",
					"type": "Expression"
				},
				"folderPath": "on-prem-loaded",
				"fileSystem": "layer-bronze"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "account",
				"type": "String"
			},
			{
				"name": "sector",
				"type": "String"
			},
			{
				"name": "year_established",
				"type": "String"
			},
			{
				"name": "revenue",
				"type": "String"
			},
			{
				"name": "employees",
				"type": "String"
			},
			{
				"name": "office_location",
				"type": "String"
			},
			{
				"name": "subsidiary_of",
				"type": "String"
			}
		]
	}
}